machine(MachineType:CXLdevice, "CXLdevice Controller")
 :
  CXLSequencer * cxl_sequencer;
  // Sequencer * sequencer;
  Cycles to_mem_ctrl_latency := 1;
  MessageBuffer * requestToHostcxl, network="To", virtual_network="3", vnet_type="request";
  MessageBuffer * responsefromHostcxl, network="From", virtual_network="1", vnet_type="response";

  MessageBuffer * responseToHostcxl, network="To", virtual_network="2", vnet_type="response";
  MessageBuffer * requestfromHostcxl, network="From", virtual_network="0", vnet_type="request";

  MessageBuffer * requestToMemory;
  MessageBuffer * responseFromMemory;

  // MessageBuffer * requestFromMemory;
  MessageBuffer * responseToMemory;

  MessageBuffer * mandatoryQueue;
  
{
  state_declaration(State, desc="CXL states", default="CXLdevice_State_I") {
      I, AccessPermission:Read_Write, desc="dir is the owner and memory is up-to-date, all other copies are Invalid";
      BUSY_RD, AccessPermission:Busy, desc="Busy: currently processing a request";
      BUSY_WR, AccessPermission:Busy, desc="Busy: currently processing a request";
      I_C, AccessPermission:Busy, desc="controll flit response";
      I_C_R, AccessPermission:Busy, desc="controll flit request";
      //esj 2025-07-12
      R_I_C, AccessPermission:Busy, desc="retry controll flit response";
      R_I_C_R, AccessPermission:Busy, desc="retry controll flit request";
  }

  enumeration(Event, desc="CXL events") {
    ReadRequest,  desc="A new read request";
    WriteRequest, desc="A new write request";
    Data,         desc="Data from a CXL memory read";
    Ack,          desc="CXL write to memory completed";
    ACK_ctrl,     desc="CXL control flit";
    send_ctrl,     desc="CXL control flit from host";

    ReadRequest_dma,  desc="A new read request_dma";
    WriteRequest_dma, desc="A new write request_dma";
    Data_dma,         desc="Data from a CXL memory read_dma";
    Ack_dma,          desc="CXL write to memory completed_dma";
  }


  // DirectoryEntry
  // structure(Entry, desc="...", interface="AbstractCacheEntry", main="false") {
  //   State CXL_host_State,          desc="CXL_host state";
  //   MachineID Owner;
  // }


  structure(TBE, desc="...") {
    State TBEState,    desc="Transient state";
    DataBlock DataBlk, desc="Data";
  }

  structure(TBETable, external = "yes") {
    TBE lookup(Addr);
    void allocate(Addr);
    void deallocate(Addr);
    bool isPresent(Addr);
  }


  TBETable TBEs, template="<CXLdevice_TBE>", constructor="m_number_of_TBEs";

  Tick clockEdge();
  MachineID mapAddressToMachine(Addr addr, MachineType mtype);

  State getState(TBE tbe, Addr addr) {
    if (is_valid(tbe)) {
        return tbe.TBEState;
    } else {
        return State:I;
    }
  }

  void setState(TBE tbe, Addr addr, State state) {
    if (is_valid(tbe)) {
        tbe.TBEState := state;
    }
  }

  AccessPermission getAccessPermission(Addr addr) {
    TBE tbe := TBEs[addr];
    if(is_valid(tbe)) {
        return CXLdevice_State_to_permission(tbe.TBEState);
    }

    return AccessPermission:NotPresent;
  }

  void functionalRead(Addr addr, Packet *pkt) {
    error("DMA does not support functional read.");
  }

  int functionalWrite(Addr addr, Packet *pkt) {
    error("DMA does not support functional write.");
  }

  void setAccessPermission(Addr addr, State state) {
  }

  void wakeUpBuffers(Addr a);
  void set_tbe(TBE a);
  void unset_tbe();



  out_port(requestToHostcxl_out, MemoryMsg, requestToHostcxl, desc="...");
  out_port(responseToHostcxl_out, ResponseMsg, responseToHostcxl, desc="...");

  //cxl request
  out_port(memqueue_out, MemoryMsg, requestToMemory, desc="...");  
  //dma request
  out_port(memqueue_dma_out, MemoryMsg, responseToMemory, desc="...");




  //dma
  //CXL_host -> CXL_Device Resp
  in_port(responsefromHostcxl_in, MemoryMsg, responsefromHostcxl, rank = 3) {
    if (responsefromHostcxl_in.isReady(clockEdge())) {
      peek(responsefromHostcxl_in, MemoryMsg) {
        if (in_msg.Type == MemoryRequestType:MEMORY_DATA) {
          trigger(Event:Data, in_msg.addr, TBEs[in_msg.addr]);
        } 
        else if (in_msg.Type == MemoryRequestType:MEMORY_ACK) {
          trigger(Event:Ack, in_msg.addr, TBEs[in_msg.addr]);
        } 
        else {
          DPRINTF(RubySlicc, "%s\n", in_msg.Type);
          error("Invalid message");
        }
      }
    }
  }

  //CXL_host -> CXL_Device Resp - dma response
  // in_port(memqueue_dma_in, MemoryMsg, requestFromMemory, desc="...", rank = 0) {
  //   if (memqueue_dma_in.isReady(clockEdge())) {
  //     peek(memqueue_dma_in, MemoryMsg) {
  //       if (in_msg.Type == MemoryRequestType:MEMORY_READ) {
  //         trigger(Event:Data_dma, in_msg.addr, TBEs[in_msg.addr]);
  //       }
  //       else if (in_msg.Type == MemoryRequestType:MEMORY_WB){
  //         trigger(Event:Ack_dma, in_msg.addr, TBEs[in_msg.addr]);
  //       }
  //       else {
  //         DPRINTF(RubySlicc, "%s\n", in_msg);
  //         error("Invalid message");
  //       }
  //     }
  //   }
  // }

  in_port(mandatoryQueue_in, RubyRequest, mandatoryQueue, desc="...", rank = 2) {
    if (mandatoryQueue_in.isReady(clockEdge())) {
      peek(mandatoryQueue_in, MemoryMsg) {
        if (in_msg.Type == MemoryRequestType:MEMORY_READ) {
          trigger(Event:Data_dma, in_msg.addr, TBEs[in_msg.addr]);
        }
        else if (in_msg.Type == MemoryRequestType:MEMORY_WB){
          trigger(Event:Ack_dma, in_msg.addr, TBEs[in_msg.addr]);
        }
        else {
          DPRINTF(RubySlicc, "%s\n", in_msg);
          error("Invalid message");
        }
      }
    }
  }


  //Device -> CXL_Device Resp
  in_port(memqueue_in, MemoryMsg, responseFromMemory, desc="...", rank = 1) {
    if (memqueue_in.isReady(clockEdge())) {
      peek(memqueue_in, MemoryMsg) {
        if (in_msg.Type == MemoryRequestType:MEMORY_READ) {
          trigger(Event:Data, in_msg.addr, TBEs[in_msg.addr]);
        }
        else if (in_msg.Type == MemoryRequestType:MEMORY_WB){
          trigger(Event:Ack, in_msg.addr, TBEs[in_msg.addr]);
        }
        else if (in_msg.Type == MemoryRequestType:CONTROL_FLIT){
          trigger(Event:ACK_ctrl, in_msg.addr, TBEs[in_msg.addr]);
        }
        else {
          DPRINTF(RubySlicc, "%s\n", in_msg);
          error("Invalid message");
        }
      }
    }
  }
  //CXL_host -> CXL_device Req
  in_port(requestfromHostcxl_in, RequestMsg, requestfromHostcxl, desc="...", rank = 0) {
    if (requestfromHostcxl_in.isReady(clockEdge())) {
      peek(requestfromHostcxl_in, RequestMsg) {
        if (in_msg.Type == CoherenceRequestType:CXL_read) {
          trigger(Event:ReadRequest, in_msg.addr, TBEs[in_msg.addr]);
        }
        else if (in_msg.Type == CoherenceRequestType:CXL_write){
          trigger(Event:WriteRequest, in_msg.addr, TBEs[in_msg.addr]);
        }
        //esj 2025-04-06
        else if (in_msg.Type == CoherenceRequestType:CXL_control_flit){
          trigger(Event:send_ctrl, in_msg.addr, TBEs[in_msg.addr]);
        }
        else {
          DPRINTF(RubySlicc, "%s\n", in_msg);
          error("Invalid message");
        }
      }
    }
  }

  //CXL_Device -> Device Req/READ
  action(IR_issueREAD, "IR", desc="Issue READ ") {
    peek(requestfromHostcxl_in, RequestMsg) {
      enqueue(memqueue_out, MemoryMsg, to_mem_ctrl_latency) {
        //esj 2025-04-01
        out_msg.cxl_pkt := in_msg.cxl_pkt;

        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_READ;
        out_msg.Sender := machineID;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := 0;
      }
    }
  }
  //CXL_Device -> CXL_host Req/WRITE
  action(IW_issueWRITE, "IW", desc="Issue Write") {
    peek(requestfromHostcxl_in, RequestMsg) {
      enqueue(memqueue_out, MemoryMsg, to_mem_ctrl_latency) {
        //esj 2025-04-01
        out_msg.cxl_pkt := in_msg.cxl_pkt;
        
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_WB;
        out_msg.Sender := machineID;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := 0;
      }
    }
  }

  action(d_sendData, "d", desc="Send data to requestor") {
    peek(memqueue_in, MemoryMsg) {
      enqueue(responseToHostcxl_out, ResponseMsg, to_mem_ctrl_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:MEMORY_DATA;
        out_msg.Sender := machineID;
        out_msg.Destination.add(in_msg.OriginalRequestorMachId);
        out_msg.DataBlk := in_msg.DataBlk;
        //esj 2025-04-02
        out_msg.cxl_pkt := in_msg.cxl_pkt;
        out_msg.MessageSize := MessageSizeType:Response_Data;
      }
    }
  }

  action(aa_sendAck, "aa", desc="Send ack to requestor") {
    peek(memqueue_in, MemoryMsg) {
      enqueue(responseToHostcxl_out, ResponseMsg, to_mem_ctrl_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:MEMORY_ACK;
        out_msg.Sender := machineID;
        //esj 2025-04-02
        out_msg.cxl_pkt := in_msg.cxl_pkt;
        out_msg.Destination.add(in_msg.OriginalRequestorMachId);
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }
  }

  //esj 2025-04-06
  action(recv_ctrl_flit, "sc", desc="recv control flit") {
    peek(memqueue_in, MemoryMsg) {
      enqueue(responseToHostcxl_out, ResponseMsg, to_mem_ctrl_latency) {
        out_msg.addr := address;
        out_msg.Type := CoherenceResponseType:ACK_CTRL;
        out_msg.Sender := machineID;
        //esj 2025-04-02
        out_msg.cxl_pkt := in_msg.cxl_pkt;
        out_msg.Destination.add(in_msg.OriginalRequestorMachId);
        out_msg.MessageSize := MessageSizeType:Response_Control;
      }
    }
  }
  
  action(send_ctrl_flit, "scr", desc="send control flit") {
    peek(requestfromHostcxl_in, RequestMsg) {
      enqueue(memqueue_out, MemoryMsg, to_mem_ctrl_latency) {
        out_msg.cxl_pkt := in_msg.cxl_pkt;
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:CONTROL_FLIT;
        out_msg.Sender := machineID;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := 0;
      }
    }
  }




  //dma
  //CXL_Device -> CXL_host Req/READ
  action(IR_issueREAD_dma, "IRDM", desc="Issue READ") {
    peek(mandatoryQueue_in, MemoryMsg) {
      enqueue(requestToHostcxl_out, MemoryMsg, to_mem_ctrl_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_READ;
        out_msg.Sender := machineID;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := 0;
      }
    }
  }
  //CXL_Device -> CXL_host Req/WRITE
  action(IW_issueWRITE_dma, "IWDM", desc="Issue Write") {
    peek(mandatoryQueue_in, MemoryMsg) {
      enqueue(requestToHostcxl_out, MemoryMsg, to_mem_ctrl_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_WB;
        out_msg.Sender := machineID;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := 0;
      }
    }
  }

  //CXL_host -> CXL_Device resp
  action(IS_issueData, "IRD", desc="Issue READ Data") {
    peek(responsefromHostcxl_in, MemoryMsg) {
      enqueue(memqueue_dma_out, MemoryMsg, to_mem_ctrl_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_DATA;
        out_msg.Sender := machineID;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := 0;
      }
    }
  }

  action(IW_issueAck, "IWC", desc="Issue Write complete") {
    peek(responsefromHostcxl_in, MemoryMsg) {
      enqueue(memqueue_dma_out, MemoryMsg, to_mem_ctrl_latency) {
        out_msg.addr := address;
        out_msg.Type := MemoryRequestType:MEMORY_ACK;
        out_msg.Sender := machineID;
        out_msg.MessageSize := MessageSizeType:Request_Control;
        out_msg.Len := 0;
      }
    }
  }


  action(jj_popL1RequestQueue, "\j", desc="Pop incoming L1 request queue") {
    Tick delay := requestfromHostcxl_in.dequeue(clockEdge());
  }



  action(l_popRequestQueueTOHostcxl, "q", desc="Pop off-chip request queue") {
    mandatoryQueue_in.dequeue(clockEdge());
  }


  action(kd_wakeUpDependents, "kd", desc="wake-up dependents") {
    wakeUpBuffers(address);
  }

  action(v_allocateTBE, "v", desc="Allocate TBE") {
    peek(requestfromHostcxl_in, RequestMsg) {
      // TBEs.allocate(address);
      // set_tbe(TBEs[address]);
      // tbe.DataBlk := in_msg.DataBlk;
      if (!TBEs.isPresent(address)) {
        TBEs.allocate(address);
        set_tbe(TBEs[address]);
        DPRINTF(RubyGenerated, "Allocated TBE for Addr=%#x\n", address);
      } else {
        DPRINTF(RubyGenerated, "TBE already present for Addr=%#x\n", address);
      }
    }
  }

  action(dma_allocateTBE, "dv", desc="Allocate dma TBE") {
    peek(mandatoryQueue_in, RequestMsg) {
      // TBEs.allocate(address);
      // set_tbe(TBEs[address]);
      // tbe.DataBlk := in_msg.DataBlk;
      if (!TBEs.isPresent(address)) {
        TBEs.allocate(address);
        set_tbe(TBEs[address]);
        DPRINTF(RubyGenerated, "Allocated TBE for Addr=%#x\n", address);
      } else {
        DPRINTF(RubyGenerated, "TBE already present for Addr=%#x\n", address);
      }
    }
  }

  action(s_deallocateTBE, "s", desc="Deallocate TBE") {
    TBEs.deallocate(address);
    unset_tbe();
  }

  action(l_popMemQueue, "l", desc="Pop mem queue.") {
    memqueue_in.dequeue(clockEdge());
  }

  // action(stallandwaitresponsefromdevice, "\z", desc="Stall and wait the response from device") {
  //   stall_and_wait(memqueue_in, address);
  // }

  // // TRANSITIONS
  // transition({I,BUSY_WR,I_C,I_C_R}, {ACK_ctrl}) {
  //   stallandwaitresponsefromdevice;
  // }

  transition(I, ReadRequest,BUSY_RD) {
    v_allocateTBE;
    IR_issueREAD;
    kd_wakeUpDependents;
    jj_popL1RequestQueue;
  }

  //esj 2025-04-10
  transition({BUSY_RD, I_C },ReadRequest, BUSY_RD){ //esj 2025-08-22 I_C is added
    IR_issueREAD;
    kd_wakeUpDependents;
    jj_popL1RequestQueue;
  }

  transition({BUSY_RD, I_C, I_C_R, R_I_C_R, R_I_C}, Data, I) { //esj 2025-07-12 R_I_C_R, R_I_C is added
    d_sendData;
    s_deallocateTBE;
    kd_wakeUpDependents;
    l_popMemQueue;
  }

  // //esj 2025-04-10
  // transition(I, Data, I) {
  //   d_sendData;
  //   kd_wakeUpDependents;
  //   l_popMemQueue;
  // }
  transition(I, WriteRequest,BUSY_WR) {
    v_allocateTBE;
    IW_issueWRITE;
    kd_wakeUpDependents;
    jj_popL1RequestQueue;
  }

  //esj 2025-04-10
  transition({BUSY_WR, I_C }, WriteRequest, BUSY_WR){ //esj 2025-08-22 I_C is added
    IW_issueWRITE;
    kd_wakeUpDependents;
    jj_popL1RequestQueue;
  }
  
  transition({BUSY_WR, I_C_R, R_I_C_R, I_C, R_I_C}, Ack, I) {  //esj 2025-07-12 R_I_C_R, I_C, R_I_C is added
    aa_sendAck;
    s_deallocateTBE;
    kd_wakeUpDependents;
    l_popMemQueue;
  }

    //esj 2025-05-09
  transition({I}, Ack, I_C) {
    aa_sendAck;
    kd_wakeUpDependents;
    l_popMemQueue;
  }
  transition({I}, Data, I_C) {
    d_sendData;
    kd_wakeUpDependents;
    l_popMemQueue;
  }
  
  // //esj 2025-04-10
  // transition(I, Ack, I){
  //   aa_sendAck;
  //   kd_wakeUpDependents;
  //   l_popMemQueue;
  // }

  //controll flit
  // transition(I, Data, I_C) {
  //   d_sendData;
  //   kd_wakeUpDependents;
  // }
  transition({BUSY_RD, BUSY_WR,I_C_R, I, R_I_C_R, R_I_C}, ACK_ctrl, I_C) { //esj 2025-07-12 R_I_C_R is added //esj 2025-08-22 R_I_C is added BUSY_WR is added
    recv_ctrl_flit;
    kd_wakeUpDependents;
    l_popMemQueue;
  }
  
  transition({BUSY_RD, BUSY_WR, I, I_C, R_I_C, R_I_C_R}, send_ctrl, I_C_R) { //esj 2025-07-12 R_I_C is added //esj 2025-08-22 R_I_C_R is added
    send_ctrl_flit;
    kd_wakeUpDependents;
    jj_popL1RequestQueue;
  }

  //esj 2025-07-12
  transition({I_C}, ACK_ctrl, R_I_C) {
    recv_ctrl_flit;
    kd_wakeUpDependents;
    l_popMemQueue;
  }
  
  transition({I_C_R}, send_ctrl, R_I_C_R) {
    send_ctrl_flit;
    kd_wakeUpDependents;
    jj_popL1RequestQueue;
  }
  //

  //dma
  transition(I, ReadRequest_dma,BUSY_RD) {
    dma_allocateTBE;
    IR_issueREAD_dma;
    kd_wakeUpDependents;
  }

  transition(BUSY_RD, Data_dma, I) {
    IS_issueData;
    kd_wakeUpDependents;
  }

  transition(I, WriteRequest_dma,BUSY_WR) {
    dma_allocateTBE;
    IW_issueWRITE_dma;
    kd_wakeUpDependents;
  }
  
  transition(BUSY_WR, Ack_dma, I) {
    l_popRequestQueueTOHostcxl
    s_deallocateTBE
    IW_issueAck;
    kd_wakeUpDependents;
  }


}